# Copy to .env.local for local development. On Vercel, add these as Environment Variables.
# Supabase → Project Settings → API (or "API Keys"): Project URL and the publishable / anon key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Set to 1 to run without Supabase, storing data in this browser only (for trying the app).
# VITE_DEMO=1
